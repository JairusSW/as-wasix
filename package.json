{
  "name": "as-wasix",
  "version": "0.1.0",
  "description": "AssemblyScript bindings for WASIX on top of wasi_snapshot_preview1",
  "author": "Jairus Tanaka",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./assembly/index.ts"
    }
  },
  "types": "assembly/index.ts",
  "files": [
    "assembly/",
    "index.ts",
    "README.md",
    "LICENSE",
    "asconfig.json"
  ],
  "scripts": {
    "generate:bindings": "node tools/generate-wasix-bindings.mjs",
    "asbuild:debug": "asc assembly/test.ts --target debug",
    "asbuild:release": "asc assembly/test.ts --target release",
    "asbuild:test": "asc assembly/test.ts --target test",
    "asbuild": "npm run asbuild:debug && npm run asbuild:release && npm run asbuild:test",
    "test": "ast test --disable coverage",
    "test:ci": "ast test --disable coverage --clean",
    "verify": "npm run generate:bindings && npm run asbuild && npm run test:ci"
  },
  "devDependencies": {
    "@assemblyscript/wasi-shim": "^0.1.0",
    "as-test": "^1.0.3",
    "assemblyscript": "^0.28.9"
  },
  "peerDependencies": {
    "@assemblyscript/wasi-shim": "^0.1.0"
  },
  "keywords": [
    "assemblyscript",
    "wasm",
    "wasi",
    "wasix",
    "wasmer"
  ]
}
